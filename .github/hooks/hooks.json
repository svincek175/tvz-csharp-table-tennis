{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "./route-ui-to-ux-agent.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 15
      },
      {
        "type": "command",
        "bash": "./log-agent-input.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 15
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "./log-agent-input.sh",
        "cwd": ".github/hooks",
        "timeoutSec": 15
      }
    ]
  }
}