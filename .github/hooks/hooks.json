{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "./.github/hooks/log-agent-input.sh userPromptSubmitted",
        "cwd": ".",
        "timeoutSec": 15
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "./.github/hooks/log-agent-input.sh preToolUse",
        "cwd": ".",
        "timeoutSec": 15
      }
    ]
  }
}