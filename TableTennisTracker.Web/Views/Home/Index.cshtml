@model DashboardViewModel
@{
    ViewData["Title"] = "Home";
    ViewData["Breadcrumbs"] = new List<(string, string)> { ("Home", "/") };
}

<style>
    /* MAIN DASHBOARD LAYOUT */
    .dashboard-container {
        display: grid;
        gap: 32px;
    }

    /* HERO SECTION */
    .dashboard-hero {
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.2) 0%, rgba(59, 130, 246, 0.15) 100%);
        border: 1px solid rgba(139, 92, 246, 0.3);
        border-radius: 20px;
        padding: 40px;
        margin-bottom: 16px;
    }

    .hero-content {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 32px;
    }

    .hero-text h1 {
        font-size: 2.8rem;
        font-weight: 800;
        color: #e0e7ff;
        margin-bottom: 12px;
        letter-spacing: -0.5px;
    }

    .hero-text p {
        font-size: 1.1rem;
        color: #a5b4fc;
        line-height: 1.6;
    }

    .hero-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        min-width: 350px;
    }

    .stat-box {
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 12px;
        padding: 16px;
        text-align: center;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: #c7d2fe;
        margin-bottom: 4px;
    }

    .stat-label {
        font-size: 0.85rem;
        color: #8b5cf6;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* FEATURED QUIZ CARD */
    .quiz-hero {
        background: linear-gradient(135deg, rgba(236, 72, 153, 0.2) 0%, rgba(245, 158, 11, 0.15) 100%);
        border: 2px solid rgba(236, 72, 153, 0.4);
        border-radius: 16px;
        padding: 32px;
        text-align: center;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        position: relative;
        overflow: hidden;
        margin-bottom: 32px;
    }

    .quiz-hero:hover {
        transform: translateY(-8px);
        border-color: rgba(236, 72, 153, 0.6);
        box-shadow: 0 20px 60px rgba(236, 72, 153, 0.2);
    }

    .quiz-hero h2 {
        font-size: 1.8rem;
        color: #e0e7ff;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

    .quiz-hero p {
        font-size: 1rem;
        color: #cbd5e1;
        margin-bottom: 20px;
    }

    .quiz-cta {
        display: inline-block;
        background: linear-gradient(120deg, #ec4899, #f59e0b);
        color: #fff;
        padding: 12px 28px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        font-size: 0.95rem;
    }

    .quiz-cta:hover {
        transform: scale(1.06);
        box-shadow: 0 10px 25px rgba(236, 72, 153, 0.3);
    }

    /* TWO COLUMN LAYOUT */
    .dashboard-content {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 32px;
    }

    .left-column {
        display: grid;
        gap: 32px;
    }

    .right-column {
        display: grid;
        gap: 32px;
    }

    /* CALENDAR SECTION */
    .calendar-section {
        background: rgba(139, 92, 246, 0.08);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 16px;
        padding: 24px;
        backdrop-filter: blur(10px);
    }

    .calendar-section h3 {
        color: #e0e7ff;
        font-size: 1.3rem;
        margin-bottom: 20px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 8px;
        margin-bottom: 20px;
    }

    .calendar-day-header {
        text-align: center;
        color: #8b5cf6;
        font-weight: 600;
        font-size: 0.8rem;
        padding: 8px 0;
        text-transform: uppercase;
    }

    .calendar-day {
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(139, 92, 246, 0.15);
        color: #cbd5e1;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.9rem;
    }

    .calendar-day:hover {
        background: rgba(139, 92, 246, 0.2);
        border-color: rgba(139, 92, 246, 0.3);
    }

    .calendar-day.other-month {
        color: #6b7280;
        opacity: 0.5;
    }

    .calendar-day.today {
        background: linear-gradient(135deg, #8b5cf6, #6366f1);
        border-color: #8b5cf6;
        color: #fff;
        font-weight: 700;
    }

    .calendar-day.has-event {
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.3), rgba(59, 130, 246, 0.2));
        border: 2px solid rgba(139, 92, 246, 0.4);
        position: relative;
    }

    .calendar-day.has-event::after {
        content: '•';
        position: absolute;
        top: 2px;
        right: 4px;
        color: #f59e0b;
        font-size: 1.2rem;
    }

    .upcoming-tournaments-list {
        display: grid;
        gap: 12px;
    }

    .tournament-item {
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 10px;
        padding: 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.3s ease;
    }

    .tournament-item:hover {
        background: rgba(139, 92, 246, 0.15);
        border-color: rgba(139, 92, 246, 0.3);
        transform: translateX(4px);
    }

    .tournament-item-info {
        flex: 1;
    }

    .tournament-item-name {
        color: #e0e7ff;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .tournament-item-date {
        color: #a5b4fc;
        font-size: 0.85rem;
    }

    .tournament-item-status {
        display: inline-block;
        background: rgba(59, 130, 246, 0.2);
        border: 1px solid rgba(59, 130, 246, 0.3);
        color: #93c5fd;
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    /* LEADERBOARD SECTION */
    .leaderboard-section {
        background: rgba(139, 92, 246, 0.08);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 16px;
        padding: 24px;
        backdrop-filter: blur(10px);
    }

    .leaderboard-section h3 {
        color: #e0e7ff;
        font-size: 1.3rem;
        margin-bottom: 20px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .leaderboard-list {
        display: grid;
        gap: 12px;
    }

    .leaderboard-item {
        display: grid;
        grid-template-columns: 40px 1fr auto;
        align-items: center;
        gap: 14px;
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 10px;
        padding: 12px;
        transition: all 0.3s ease;
    }

    .leaderboard-item:hover {
        background: rgba(139, 92, 246, 0.15);
        border-color: rgba(139, 92, 246, 0.3);
        transform: translateX(4px);
    }

    .rank-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        font-weight: 700;
        font-size: 1rem;
    }

    .rank-badge.rank-1 {
        background: linear-gradient(135deg, #fbbf24, #f59e0b);
        color: #000;
    }

    .rank-badge.rank-2 {
        background: linear-gradient(135deg, #d1d5db, #9ca3af);
        color: #000;
    }

    .rank-badge.rank-3 {
        background: linear-gradient(135deg, #f97316, #ea580c);
        color: #fff;
    }

    .rank-badge.other {
        background: rgba(139, 92, 246, 0.2);
        color: #c7d2fe;
    }

    .player-info {
        display: flex;
        flex-direction: column;
    }

    .player-name {
        color: #e0e7ff;
        font-weight: 600;
        margin-bottom: 2px;
    }

    .player-stats {
        color: #8b5cf6;
        font-size: 0.8rem;
    }

    .player-points {
        color: #60a5fa;
        font-weight: 700;
        font-size: 1.1rem;
    }

    /* RECENT MATCHES SECTION */
    .recent-matches-section {
        background: rgba(139, 92, 246, 0.08);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 16px;
        padding: 24px;
        backdrop-filter: blur(10px);
    }

    .recent-matches-section h3 {
        color: #e0e7ff;
        font-size: 1.3rem;
        margin-bottom: 20px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .match-list {
        display: grid;
        gap: 12px;
    }

    .match-card {
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 10px;
        padding: 14px;
        transition: all 0.3s ease;
    }

    .match-card:hover {
        background: rgba(139, 92, 246, 0.15);
        border-color: rgba(139, 92, 246, 0.3);
        transform: translateX(4px);
    }

    .match-players {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
    }

    .player-matchup {
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 1;
    }

    .player-name-match {
        color: #e0e7ff;
        font-weight: 600;
        font-size: 0.95rem;
    }

    .vs-badge {
        background: rgba(139, 92, 246, 0.2);
        color: #8b5cf6;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        min-width: 35px;
        text-align: center;
    }

    .match-score {
        color: #f59e0b;
        font-weight: 700;
    }

    .match-tournament {
        color: #a5b4fc;
        font-size: 0.8rem;
    }

    /* ENTITY CARDS GRID */
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .entity-card {
        background: rgba(139, 92, 246, 0.08);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 12px;
        padding: 20px;
        text-decoration: none;
        color: #fff;
        transition: all 0.3s ease;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        backdrop-filter: blur(10px);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 160px;
    }

    .entity-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(139, 92, 246, 0.1), transparent);
        transition: left 0.5s ease;
    }

    .entity-card:hover {
        transform: translateY(-6px);
        border-color: rgba(139, 92, 246, 0.4);
        background: rgba(139, 92, 246, 0.12);
        box-shadow: 0 12px 30px rgba(139, 92, 246, 0.15);
    }

    .entity-card:hover::before {
        left: 100%;
    }

    .entity-card-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 12px;
        position: relative;
        z-index: 1;
    }

    .entity-icon {
        font-size: 2rem;
    }

    .entity-count {
        font-size: 1.6rem;
        font-weight: 700;
        color: #60a5fa;
    }

    .entity-name {
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 4px;
        position: relative;
        z-index: 1;
    }

    .entity-label {
        font-size: 0.8rem;
        color: #8b5cf6;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        position: relative;
        z-index: 1;
    }

    /* RESPONSIVE DESIGN */
    @@media (max-width: 1200px) {
        .dashboard-content {
            grid-template-columns: 1fr;
        }

        .hero-stats {
            min-width: auto;
        }
    }

    @@media (max-width: 768px) {
        .dashboard-hero {
            padding: 24px;
        }

        .hero-content {
            flex-direction: column;
            gap: 24px;
        }

        .hero-text h1 {
            font-size: 2rem;
        }

        .hero-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .dashboard-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .calendar-grid {
            gap: 6px;
        }
    }

    @@media (max-width: 480px) {
        .hero-stats {
            grid-template-columns: 1fr;
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
        }
    }

    .empty-state {
        text-align: center;
        color: #8b5cf6;
        padding: 24px;
        font-size: 0.95rem;
    }
</style>

<div class="dashboard-container">
    <!-- HERO SECTION -->
    <div class="dashboard-hero">
        <div class="hero-content">
            <div class="hero-text">
                <h1>🏓 Tournament Tracker</h1>
                <p>Manage tournaments, players, and matches with real-time insights and analytics</p>
            </div>
            <div class="hero-stats">
                <div class="stat-box">
                    <div class="stat-value">@Model.TournamentCount</div>
                    <div class="stat-label">Tournaments</div>
                </div>
                <div class="stat-box">
                    <div class="stat-value">@Model.PlayerCount</div>
                    <div class="stat-label">Players</div>
                </div>
                <div class="stat-box">
                    <div class="stat-value">@Model.MatchCount</div>
                    <div class="stat-label">Matches</div>
                </div>
            </div>
        </div>
    </div>

    <!-- FEATURED QUIZ -->
    <div class="quiz-hero">
        <h2>🧠 Quiz Master Challenge</h2>
        <p>Test your knowledge about table tennis tournaments and rules</p>
        <a href="/Quiz" style="text-decoration: none;">
            <button class="quiz-cta">Start Quiz →</button>
        </a>
    </div>

    <!-- MAIN CONTENT GRID -->
    <div class="dashboard-content">
        <!-- LEFT COLUMN -->
        <div class="left-column">
            <!-- UPCOMING TOURNAMENTS / CALENDAR -->
            <div class="calendar-section">
                <h3>📅 Upcoming Tournaments</h3>
                <div class="upcoming-tournaments-list" id="upcomingTournaments">
                    <div class="empty-state">No upcoming tournaments</div>
                </div>
            </div>

            <!-- RECENT MATCHES -->
            <div class="recent-matches-section">
                <h3>⚔️ Recent Matches</h3>
                <div class="match-list" id="recentMatches">
                    <div class="empty-state">No recent matches</div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class="right-column">
            <!-- PLAYER LEADERBOARD -->
            <div class="leaderboard-section">
                <h3>🏅 Top Players</h3>
                <div class="leaderboard-list" id="leaderboard">
                    <div class="empty-state">No players yet</div>
                </div>
            </div>

            <!-- ENTITY CARDS -->
            <div style="display: grid; gap: 16px;">
                <a href="/Tournaments" class="entity-card">
                    <div class="entity-card-header">
                        <div class="entity-icon">🏆</div>
                        <div class="entity-count">@Model.TournamentCount</div>
                    </div>
                    <div>
                        <div class="entity-name">Tournaments</div>
                        <div class="entity-label">View All</div>
                    </div>
                </a>

                <a href="/Players" class="entity-card">
                    <div class="entity-card-header">
                        <div class="entity-icon">👥</div>
                        <div class="entity-count">@Model.PlayerCount</div>
                    </div>
                    <div>
                        <div class="entity-name">Players</div>
                        <div class="entity-label">View All</div>
                    </div>
                </a>

                <a href="/Matches" class="entity-card">
                    <div class="entity-card-header">
                        <div class="entity-icon">⚔️</div>
                        <div class="entity-count">@Model.MatchCount</div>
                    </div>
                    <div>
                        <div class="entity-name">Matches</div>
                        <div class="entity-label">View All</div>
                    </div>
                </a>

                <a href="/Registrations" class="entity-card">
                    <div class="entity-card-header">
                        <div class="entity-icon">📋</div>
                        <div class="entity-count">@Model.RegistrationCount</div>
                    </div>
                    <div>
                        <div class="entity-name">Registrations</div>
                        <div class="entity-label">View All</div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Render upcoming tournaments
        const tournamentsContainer = document.getElementById('upcomingTournaments');
        const tournaments = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UpcomingTournaments.Select(t => new { 
            name = t.Name, 
            startUtc = t.StartUtc,
            id = t.Id
        })));
        
        if (tournaments.length > 0) {
            tournamentsContainer.innerHTML = tournaments.map(t => `
                <a href="/Tournaments/Details/${t.id}" style="text-decoration: none; color: inherit;">
                    <div class="tournament-item">
                        <div class="tournament-item-info">
                            <div class="tournament-item-name">${t.name || 'Tournament'}</div>
                            <div class="tournament-item-date">${new Date(t.startUtc).toLocaleDateString()}</div>
                        </div>
                        <div class="tournament-item-status">Upcoming</div>
                    </div>
                </a>
            `).join('');
        }

        // Render leaderboard
        const leaderboardContainer = document.getElementById('leaderboard');
        const topPlayers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopPlayers.Select(p => new { 
            firstName = p.FirstName,
            lastName = p.LastName,
            countryCode = p.CountryCode,
            currentRankingPoints = p.CurrentRankingPoints,
            id = p.Id
        })));
        
        if (topPlayers.length > 0) {
            leaderboardContainer.innerHTML = topPlayers.map((p, i) => {
                let rankClass = 'other';
                if (i === 0) rankClass = 'rank-1';
                else if (i === 1) rankClass = 'rank-2';
                else if (i === 2) rankClass = 'rank-3';
                
                return `
                    <a href="/Players/Details/${p.id}" style="text-decoration: none; color: inherit;">
                        <div class="leaderboard-item">
                            <div class="rank-badge ${rankClass}">${i + 1}</div>
                            <div class="player-info">
                                <div class="player-name">${p.firstName || ''} ${p.lastName || 'Player'}</div>
                                <div class="player-stats">${p.countryCode || 'Unknown'}</div>
                            </div>
                            <div class="player-points">${p.currentRankingPoints || 0}</div>
                        </div>
                    </a>
                `;
            }).join('');
        }

        // Render recent matches
        const recentMatchesContainer = document.getElementById('recentMatches');
        const recentMatches = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RecentMatches.Select(m => new { 
            id = m.Id,
            tournament = m.Tournament != null ? m.Tournament.Name : "Tournament",
            scheduledStartUtc = m.ScheduledStartUtc,
            status = m.Status.ToString(),
            participant1 = m.Participants.FirstOrDefault() != null && m.Participants.FirstOrDefault().Player != null ? m.Participants.FirstOrDefault().Player.FirstName + " " + m.Participants.FirstOrDefault().Player.LastName : "Player 1",
            participant2 = m.Participants.Skip(1).FirstOrDefault() != null && m.Participants.Skip(1).FirstOrDefault().Player != null ? m.Participants.Skip(1).FirstOrDefault().Player.FirstName + " " + m.Participants.Skip(1).FirstOrDefault().Player.LastName : "Player 2"
        })));
        
        if (recentMatches.length > 0) {
            recentMatchesContainer.innerHTML = recentMatches.map(m => `
                <a href="/Matches/Details/${m.id}" style="text-decoration: none; color: inherit;">
                    <div class="match-card">
                        <div class="match-players">
                            <div class="player-matchup" style="flex: 1;">
                                <span class="player-name-match">${m.participant1}</span>
                            </div>
                            <div class="vs-badge">vs</div>
                            <div class="player-matchup" style="flex: 1; justify-content: flex-end;">
                                <span class="player-name-match">${m.participant2}</span>
                            </div>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span class="match-tournament">${m.tournament}</span>
                            <span class="match-score">${m.status}</span>
                        </div>
                    </div>
                </a>
            `).join('');
        }
    });
</script>
</div>
