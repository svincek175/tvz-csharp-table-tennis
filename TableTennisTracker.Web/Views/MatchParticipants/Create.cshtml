@model TableTennisTracker.Domain.Models.MatchParticipant
@using TableTennisTracker.Web.ViewModels

@{
    ViewData["Title"] = "Add New Match Participant";
    ViewData["Breadcrumbs"] = new List<(string, string)> { ("Home", "/"), ("Match Participants", "/match-participants/list"), ("Create", "") };
}

<style>
    .form-container {
        max-width: 500px;
        margin: 0 auto;
    }

    .form-header {
        margin-bottom: 32px;
    }

    .form-header h1 {
        color: #e0e7ff;
        font-size: 1.8rem;
        margin-bottom: 8px;
    }

    .form-group {
        margin-bottom: 36px;
    }

    .form-label {
        display: block;
        color: #e0e7ff;
        margin-bottom: 10px;
        font-weight: 500;
        font-size: 0.9rem;
    }

    .form-control,
    .form-select {
        width: 100%;
        padding: 13px 14px;
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 6px;
        color: #e0e7ff;
        font-size: 0.9rem;
        box-sizing: border-box;
    }

    .form-control:focus,
    .form-select:focus {
        outline: none;
        border-color: rgba(139, 92, 246, 0.5);
        background: rgba(139, 92, 246, 0.15);
    }

    .validation-error {
        color: #fca5a5;
        font-size: 0.8rem;
        margin-top: 6px;
        margin-bottom: 16px;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 36px;
    }

    .btn-submit {
        background: rgba(139, 92, 246, 0.9);
        color: white;
        padding: 11px 24px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.95rem;
        font-weight: 500;
        transition: background 0.3s;
    }

    .btn-submit:hover {
        background: rgba(139, 92, 246, 1);
    }

    .btn-cancel {
        background: transparent;
        color: #9ca3af;
        padding: 11px 24px;
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        font-size: 0.95rem;
        transition: all 0.3s;
    }

    .btn-cancel:hover {
        color: #e0e7ff;
        border-color: rgba(139, 92, 246, 0.4);
    }
</style>

<div class="form-container">
    <div class="form-header">
        <h1>👥 Add New Match Participant</h1>
    </div>

    <form method="post" action="/match-participants/create">
        @Html.AntiForgeryToken()

        @await Html.PartialAsync("_AutocompleteLookup", new AutocompleteLookupViewModel
        {
            InputId = nameof(Model.MatchId),
            InputName = nameof(Model.MatchId),
            Label = "Match *",
            Placeholder = "Search matches...",
            LookupUrl = "/matches/lookup"
        })
        @Html.ValidationMessageFor(m => m.MatchId, "", new { @class = "validation-error" })

        @await Html.PartialAsync("_AutocompleteLookup", new AutocompleteLookupViewModel
        {
            InputId = nameof(Model.PlayerId),
            InputName = nameof(Model.PlayerId),
            Label = "Player *",
            Placeholder = "Search players...",
            LookupUrl = "/players/lookup"
        })
        @Html.ValidationMessageFor(m => m.PlayerId, "", new { @class = "validation-error" })

        <div class="form-group">
            <label class="form-label">Slot</label>
            @Html.TextBoxFor(m => m.Slot, new { @class = "form-control", type = "number", @placeholder = "1" })
            @Html.ValidationMessageFor(m => m.Slot, "", new { @class = "validation-error" })
        </div>

        <div class="form-group">
            <label class="form-label">Sets Won</label>
            @Html.TextBoxFor(m => m.ScoreSetsWon, new { @class = "form-control", type = "number" })
            @Html.ValidationMessageFor(m => m.ScoreSetsWon, "", new { @class = "validation-error" })
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">Create Participant</button>
            <a href="/match-participants/list" class="btn-cancel">Cancel</a>
        </div>
    </form>
</div>
