@model IEnumerable<TableTennisTracker.Domain.Models.MatchParticipant>

@if (Model == null || !Model.Any())
{
    <div style="text-align: center; padding: 40px; color: #9ca3af;">
        <p>No match participants found.</p>
    </div>
}
else
{
    @foreach (var participant in Model)
    {
        <div class="participant-row">
            <div class="participant-info">
                <div class="participant-name">@participant.Player?.FirstName @participant.Player?.LastName</div>
                <div class="participant-meta">
                    Match: @participant.Match?.Tournament?.Name (R@participant.Match?.RoundNumber) |
                    Slot: @participant.Slot | Sets Won: @participant.ScoreSetsWon
                </div>
            </div>
            <div class="participant-actions">
                <a href="/match-participants/view/@participant.Id" class="btn-small btn-view">View</a>
                <a href="/match-participants/edit/@participant.Id" class="btn-small btn-edit">Edit</a>
                <a href="/match-participants/delete/@participant.Id" class="btn-small btn-delete">Delete</a>
            </div>
        </div>
    }
}
