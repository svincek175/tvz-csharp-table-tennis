@model IEnumerable<TableTennisTracker.Domain.Models.Match>

@{
    ViewData["Title"] = "Matches";
    ViewData["Breadcrumbs"] = new List<(string, string)> { ("Home", "/"), ("Matches", "/matches/all") };
}

<style>
    .matches-header {
        margin-bottom: 32px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }

    .header-controls {
        display: flex;
        gap: 12px;
        align-items: center;
        flex: 1;
        min-width: 0;
        width: 100%;
    }

    .matches-header h1 {
        font-size: 2.2rem;
        color: #e0e7ff;
        margin-bottom: 0;
        font-weight: 700;
    }

    .search-box {
        flex: 1;
        min-width: 0;
        width: 100%;
        padding: 10px 14px;
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 8px;
        color: #e0e7ff;
        font-size: 0.9rem;
    }

    .search-box::placeholder {
        color: #6b7280;
    }

    .filter-select {
        min-width: 160px;
        padding: 10px 14px;
        background: rgba(139, 92, 246, 0.15);
        border: 1px solid rgba(139, 92, 246, 0.25);
        border-radius: 8px;
        color: #e0e7ff;
        font-size: 0.9rem;
    }

    .btn-primary {
        background: rgba(139, 92, 246, 0.9);
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        font-size: 0.9rem;
        transition: background 0.3s;
    }

    .btn-primary:hover {
        background: rgba(139, 92, 246, 1);
    }

    .matches-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
        .matches-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 20px;
        }

        .match-card {
            background: rgba(139, 92, 246, 0.08);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
        }

        .match-card:hover {
            transform: translateY(-6px);
            border-color: rgba(139, 92, 246, 0.35);
            box-shadow: 0 16px 40px rgba(139, 92, 246, 0.16);
        }

        .match-card-header {
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.18), rgba(59, 130, 246, 0.12));
            padding: 16px 20px;
            border-bottom: 1px solid rgba(139, 92, 246, 0.18);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .match-info-small {
            font-size: 0.85rem;
            color: #a5b4fc;
        }

        .match-status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .status-scheduled {
            background: rgba(59, 130, 246, 0.2);
            color: #93c5fd;
        }

        .status-in-progress {
            background: rgba(245, 158, 11, 0.2);
            color: #fbbf24;
            animation: pulse 2s ease-in-out infinite;
        }

        .status-completed {
            background: rgba(34, 197, 94, 0.2);
            color: #86efac;
        }

        .match-card-body {
            padding: 20px;
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .match-players {
            display: flex;
            flex-direction: column;
            gap: 14px;
            margin-bottom: 18px;
        }

        .match-player {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(139, 92, 246, 0.1);
            padding: 14px 12px;
            border-radius: 10px;
            border: 1px solid rgba(139, 92, 246, 0.15);
        }

        .player-details {
            display: flex;
            flex-direction: column;
        }

        .player-name-match {
            color: #e0e7ff;
            font-weight: 700;
            margin-bottom: 4px;
            font-size: 0.95rem;
        }

        .player-country-match {
            color: #8b5cf6;
            font-size: 0.8rem;
        }

        .vs-separator {
            text-align: center;
            color: #6366f1;
            font-weight: 700;
            font-size: 1rem;
        }

        .match-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 12px;
            margin-top: 8px;
            padding-top: 16px;
            border-top: 1px solid rgba(139, 92, 246, 0.2);
        }

        .detail-item {
            display: flex;
            flex-direction: column;
        }

        .detail-label {
            color: #8b5cf6;
            font-size: 0.75rem;
            text-transform: uppercase;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .detail-value {
            color: #e0e7ff;
            font-weight: 600;
        }

        .match-card-footer {
            padding: 14px 20px 20px;
            border-top: 1px solid rgba(139, 92, 246, 0.16);
        }

        .btn-details {
            width: 100%;
            padding: 10px 16px;
            background: rgba(59, 130, 246, 0.2);
            border: 1px solid rgba(59, 130, 246, 0.3);
            color: #93c5fd;
            border-radius: 8px;
            text-decoration: none;
            text-align: center;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .btn-details:hover {
            background: rgba(59, 130, 246, 0.3);
            border-color: rgba(59, 130, 246, 0.5);
            color: #e0e7ff;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #8b5cf6;
        }

        .empty-state-icon {
            font-size: 3rem;
            margin-bottom: 16px;
        }

        .empty-state-text {
            font-size: 1.1rem;
            margin-bottom: 8px;
        }

        @@keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.8; }
        }

        @@media (max-width: 768px) {
            .matches-grid {
                grid-template-columns: 1fr;
            }

            .matches-header h1 {
                font-size: 1.8rem;
            }
        }
    </style>

    <div class="matches-header">
        <h1>⚔️ Matches</h1>
        <div class="header-controls">
            <select id="filterSelect" class="filter-select">
                <option value="all">All fields</option>
                <option value="tournament">Tournament</option>
                <option value="round">Round</option>
                <option value="status">Status</option>
            </select>
            <input type="text" id="searchInput" class="search-box" placeholder="Search matches by tournament...">
            <a href="/matches/create" class="btn-primary">+ Add New Match</a>
        </div>
    </div>

    <div id="resultsList" class="matches-list">
        @await Html.PartialAsync("_MatchesList", Model)
    </div>

    <script>
        $(document).ready(function() {
            function refreshMatches() {
                var query = $('#searchInput').val();
                var filter = $('#filterSelect').val();
                $.get('/matches/search?query=' + encodeURIComponent(query) + '&filter=' + encodeURIComponent(filter), function(data) {
                    $('#resultsList').html(data);
                });
            }

            $('#searchInput').on('keyup', refreshMatches);
            $('#filterSelect').on('change', refreshMatches);
        });
    </script>

