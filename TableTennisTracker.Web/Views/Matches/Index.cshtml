@model IEnumerable<TableTennisTracker.Domain.Models.Match>

@{
    ViewData["Title"] = "Matches";
    ViewData["Breadcrumbs"] = new List<(string, string)> { ("Home", "/"), ("Matches", "/Matches") };
}

<style>
    .matches-header {
        margin-bottom: 32px;
    }

    .matches-header h1 {
        font-size: 2.2rem;
        color: #e0e7ff;
        margin-bottom: 8px;
        font-weight: 700;
    }

    .matches-filter {
        display: flex;
        gap: 12px;
        margin-top: 16px;
        flex-wrap: wrap;
    }

    .filter-btn {
        padding: 8px 16px;
        border-radius: 8px;
        border: 1px solid rgba(139, 92, 246, 0.3);
        background: rgba(139, 92, 246, 0.1);
        color: #a5b4fc;
        cursor: pointer;
        font-weight: 500;
        transition: all 0.3s ease;
        font-size: 0.9rem;
    }

    .filter-btn:hover,
    .filter-btn.active {
        background: rgba(139, 92, 246, 0.2);
        border-color: rgba(139, 92, 246, 0.5);
        color: #e0e7ff;
    }

    .matches-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 24px;
    }

    .match-card {
        background: rgba(139, 92, 246, 0.08);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 14px;
        overflow: hidden;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
    }

    .match-card:hover {
        transform: translateY(-8px);
        border-color: rgba(139, 92, 246, 0.4);
        box-shadow: 0 16px 40px rgba(139, 92, 246, 0.15);
    }

    .match-card-header {
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(59, 130, 246, 0.15));
        padding: 16px 20px;
        border-bottom: 1px solid rgba(139, 92, 246, 0.2);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .match-info-small {
        font-size: 0.85rem;
        color: #a5b4fc;
    }

    .match-status-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-scheduled {
        background: rgba(59, 130, 246, 0.2);
        color: #93c5fd;
    }

    .status-in-progress {
        background: rgba(245, 158, 11, 0.2);
        color: #fbbf24;
        animation: pulse 2s ease-in-out infinite;
    }

    .status-completed {
        background: rgba(34, 197, 94, 0.2);
        color: #86efac;
    }

    .match-card-body {
        padding: 24px 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .match-players {
        display: flex;
        flex-direction: column;
        gap: 20px;
        margin-bottom: 20px;
    }

    .match-player {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: rgba(139, 92, 246, 0.1);
        padding: 14px 12px;
        border-radius: 10px;
        border: 1px solid rgba(139, 92, 246, 0.15);
    }

    .player-details {
        display: flex;
        flex-direction: column;
    }

    .player-name-match {
        color: #e0e7ff;
        font-weight: 700;
        margin-bottom: 4px;
        font-size: 0.95rem;
    }

    .player-country-match {
        color: #8b5cf6;
        font-size: 0.8rem;
    }

    .vs-separator {
        text-align: center;
        color: #6366f1;
        font-weight: 700;
        font-size: 1.1rem;
        margin: 4px 0;
    }

    .match-details {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid rgba(139, 92, 246, 0.2);
    }

    .detail-item {
        display: flex;
        flex-direction: column;
    }

    .detail-label {
        color: #8b5cf6;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .detail-value {
        color: #e0e7ff;
        font-weight: 600;
    }

    .match-card-footer {
        padding: 14px 20px;
        border-top: 1px solid rgba(139, 92, 246, 0.2);
    }

    .btn-details {
        width: 100%;
        padding: 10px 16px;
        background: rgba(59, 130, 246, 0.2);
        border: 1px solid rgba(59, 130, 246, 0.3);
        color: #93c5fd;
        border-radius: 8px;
        text-decoration: none;
        text-align: center;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .btn-details:hover {
        background: rgba(59, 130, 246, 0.3);
        border-color: rgba(59, 130, 246, 0.5);
        color: #e0e7ff;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #8b5cf6;
    }

    .empty-state-icon {
        font-size: 3rem;
        margin-bottom: 16px;
    }

    .empty-state-text {
        font-size: 1.1rem;
        margin-bottom: 8px;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.8; }
    }

    @@media (max-width: 768px) {
        .matches-grid {
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 16px;
        }

        .matches-header h1 {
            font-size: 1.8rem;
        }
    }

    @@media (max-width: 480px) {
        .matches-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="index-container">
    <div class="matches-header">
        <h1>⚔️ Matches</h1>
        <p style="color: #a5b4fc; margin-top: 8px;">View and manage all match results</p>
    </div>

    @if (Model.Any())
    {
        <div class="matches-grid">
            @foreach (var match in Model)
            {
                var players = match.Participants.Take(2).ToList();
                var player1 = players.FirstOrDefault();
                var player2 = players.LastOrDefault();
                
                var statusClass = "status-scheduled";
                if (match.Status == TableTennisTracker.Domain.Enums.MatchStatus.InProgress)
                    statusClass = "status-in-progress";
                else if (match.Status == TableTennisTracker.Domain.Enums.MatchStatus.Completed)
                    statusClass = "status-completed";

                <div class="match-card">
                    <div class="match-card-header">
                        <div class="match-info-small">
                            Round @match.RoundNumber • Table @match.TableNumber
                        </div>
                        <div class="match-status-badge @statusClass">
                            @match.Status
                        </div>
                    </div>

                    <div class="match-card-body">
                        @if (player1 != null && player2 != null)
                        {
                            <div class="match-players">
                                <div class="match-player">
                                    <div class="player-details">
                                        <div class="player-name-match">
                                            @(player1.Player?.FirstName ?? "Player") @(player1.Player?.LastName ?? "1")
                                        </div>
                                        <div class="player-country-match">
                                            @(player1.Player?.CountryCode ?? "—")
                                        </div>
                                    </div>
                                </div>

                                <div class="vs-separator">VS</div>

                                <div class="match-player">
                                    <div class="player-details">
                                        <div class="player-name-match">
                                            @(player2.Player?.FirstName ?? "Player") @(player2.Player?.LastName ?? "2")
                                        </div>
                                        <div class="player-country-match">
                                            @(player2.Player?.CountryCode ?? "—")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="match-details">
                            <div class="detail-item">
                                <div class="detail-label">Scheduled</div>
                                <div class="detail-value">@match.ScheduledStartUtc.ToString("MMM dd, HH:mm")</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">Best Of</div>
                                <div class="detail-value">@match.BestOfSets Sets</div>
                            </div>
                            @if (match.WinnerPlayer != null)
                            {
                                <div class="detail-item">
                                    <div class="detail-label">Winner</div>
                                    <div class="detail-value" style="color: #86efac;">
                                        ⭐ @match.WinnerPlayer.FirstName @match.WinnerPlayer.LastName
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="match-card-footer">
                        <a href="/Matches/Details/@match.Id" class="btn-details">View Details →</a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">⚔️</div>
            <div class="empty-state-text">No matches yet</div>
            <p style="color: #6b7280; font-size: 0.95rem;">Schedule your first match to get started</p>
        </div>
    }
</div>

