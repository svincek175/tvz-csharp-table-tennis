@model TableTennisTracker.Domain.Models.Player

@{
    ViewData["Title"] = "Player Details";
    ViewData["Breadcrumbs"] = new List<(string, string)> { ("Home", "/"), ("Players", "/Players"), ($"{Model.FirstName} {Model.LastName}", "") };
}

<div class="details-container">
    <h1><span class="icon-label">👤</span>@Model.FirstName @Model.LastName</h1>

    <!-- Header Section -->
    <div class="details-header">
        <div class="stat-row">
            <div class="stat-item">
                <div class="stat-item-label">🏆 Ranking Points</div>
                <div class="stat-item-value">@Model.CurrentRankingPoints</div>
            </div>
            <div class="stat-item">
                <div class="stat-item-label">🎯 Registrations</div>
                <div class="stat-item-value">@Model.Registrations.Count</div>
            </div>
            <div class="stat-item">
                <div class="stat-item-label">⚔️ Match Participations</div>
                <div class="stat-item-value">@Model.MatchParticipations.Count</div>
            </div>
            <div class="stat-item">
                <div class="stat-item-label">Status</div>
                <div class="stat-item-value">
                    @if (Model.IsActive)
                    {
                        <span class="badge badge-success">Active</span>
                    }
                    else
                    {
                        <span class="badge badge-danger">Inactive</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Main Information -->
    <div class="details-section">
        <div class="details-section-title">📋 Personal Information</div>
        <div class="details-grid">
            <div class="detail-card">
                <span class="detail-card-label">First Name</span>
                <span class="detail-card-value">@Model.FirstName</span>
            </div>
            <div class="detail-card">
                <span class="detail-card-label">Last Name</span>
                <span class="detail-card-value">@Model.LastName</span>
            </div>
            <div class="detail-card">
                <span class="detail-card-label">Date of Birth</span>
                <span class="detail-card-value">@Model.DateOfBirth.ToString("MMMM dd, yyyy")</span>
            </div>
            <div class="detail-card">
                <span class="detail-card-label">Country</span>
                <span class="detail-card-value">@Model.CountryCode</span>
            </div>
        </div>
    </div>

    <!-- Activity Section -->
    <div class="details-section">
        <div class="details-section-title">⏰ Activity Timeline</div>
        <div class="details-grid">
            <div class="detail-card">
                <span class="detail-card-label">Member Since</span>
                <span class="detail-card-value">@Model.CreatedUtc.ToString("MMMM dd, yyyy")</span>
            </div>
            <div class="detail-card">
                <span class="detail-card-label">Account Status</span>
                <span class="detail-card-value">
                    @if (Model.IsActive)
                    {
                        <span class="badge badge-success">🟢 Active</span>
                    }
                    else
                    {
                        <span class="badge badge-danger">🔴 Inactive</span>
                    }
                </span>
            </div>
        </div>
    </div>
</div>
