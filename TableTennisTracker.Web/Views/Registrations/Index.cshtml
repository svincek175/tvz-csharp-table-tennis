@model IEnumerable<TableTennisTracker.Domain.Models.Registration>

@{
    ViewData["Title"] = "Registrations";
    ViewData["Breadcrumbs"] = new List<(string, string)> { ("Home", "/"), ("Registrations", "/registrations/current") };
}

<style>
    .registrations-header {
        margin-bottom: 32px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }

    .registrations-header h1 {
        font-size: 2.2rem;
        color: #e0e7ff;
        margin-bottom: 0;
        font-weight: 700;
    }

    .search-box {
        flex: 1;
        min-width: 0;
        width: 100%;
        padding: 10px 14px;
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 8px;
        color: #e0e7ff;
        font-size: 0.9rem;
    }

    .header-controls {
        display: flex;
        gap: 12px;
        align-items: center;
        width: 100%;
        min-width: 0;
    }

    .search-box::placeholder {
        color: #6b7280;
    }

    .filter-select {
        min-width: 160px;
        padding: 10px 14px;
        background: rgba(139, 92, 246, 0.15);
        border: 1px solid rgba(139, 92, 246, 0.25);
        border-radius: 8px;
        color: #e0e7ff;
        font-size: 0.9rem;
    }

    .btn-primary {
        background: rgba(139, 92, 246, 0.9);
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        font-size: 0.9rem;
        transition: background 0.3s;
    }

    .btn-primary:hover {
        background: rgba(139, 92, 246, 1);
    }

    .registrations-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .registration-row {
        background: rgba(139, 92, 246, 0.08);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 12px;
        padding: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.2s;
    }

    .registration-row:hover {
        background: rgba(139, 92, 246, 0.12);
        border-color: rgba(139, 92, 246, 0.3);
    }

    .registration-info {
        flex: 1;
    }

    .registration-name {
        color: #e0e7ff;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .registration-meta {
        color: #9ca3af;
        font-size: 0.85rem;
    }

    .registration-actions {
        display: flex;
        gap: 8px;
        margin-left: 16px;
    }

    .btn-small {
        padding: 6px 12px;
        font-size: 0.8rem;
        text-decoration: none;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        display: inline-block;
    }

    .btn-view {
        background: rgba(34, 197, 94, 0.2);
        color: #86efac;
        border: 1px solid rgba(34, 197, 94, 0.3);
    }

    .btn-edit {
        background: rgba(59, 130, 246, 0.2);
        color: #93c5fd;
        border: 1px solid rgba(59, 130, 246, 0.3);
    }

    .btn-delete {
        background: rgba(239, 68, 68, 0.2);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .btn-small:hover {
        opacity: 0.8;
    }
</style>

<div class="registrations-header">
    <h1>📝 Registrations</h1>
    <div class="header-controls">
        <select id="filterSelect" class="filter-select">
            <option value="all">All fields</option>
            <option value="player">Player</option>
            <option value="tournament">Tournament</option>
            <option value="checkedin">Check-in state</option>
        </select>
        <input type="text" id="searchInput" class="search-box" placeholder="Search registrations by player or tournament...">
        <a href="/registrations/create" class="btn-primary">+ Add New Registration</a>
    </div>
</div>

<div id="resultsList" class="registrations-list">
    @await Html.PartialAsync("_RegistrationsList", Model)
</div>

<script>
    $(document).ready(function() {
        function refreshRegistrations() {
            var query = $('#searchInput').val();
            var filter = $('#filterSelect').val();
            $.get('/registrations/search?query=' + encodeURIComponent(query) + '&filter=' + encodeURIComponent(filter), function(data) {
                $('#resultsList').html(data);
            });
        }

        $('#searchInput').on('keyup', refreshRegistrations);
        $('#filterSelect').on('change', refreshRegistrations);
    });
</script>
