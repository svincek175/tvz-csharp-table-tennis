<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Table Tennis Tracker</title>
    <link href="https://cdn.jsdelivr.net/npm/lucide@latest" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="~/css/autocomplete-dropdown.css" />
    <link rel="stylesheet" href="~/css/animations.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="~/css/datepicker.css" />
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/hr.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #2d1b69 100%);
            color: #fff;
            min-height: 100vh;
        }

        .app-container {
            display: grid;
            grid-template-columns: 1fr;
            gap: 0;
            min-height: 100vh;
        }

        /* SIDEBAR NAVIGATION */
        .sidebar {
            background: rgba(15, 23, 42, 0.98);
            border-right: 1px solid rgba(139, 92, 246, 0.2);
            padding: 28px 16px;
            overflow-y: auto;
            position: fixed;
            left: 0;
            width: 260px;
            height: 100vh;
            backdrop-filter: blur(10px);
        }

        .sidebar-header {
            font-size: 1.3rem;
            font-weight: 800;
            margin-bottom: 32px;
            padding: 16px;
            border-radius: 12px;
            border: 2px solid rgba(139, 92, 246, 0.3);
            background: linear-gradient(120deg, rgba(139, 92, 246, 0.15), rgba(59, 130, 246, 0.15));
            color: #c7d2fe;
            display: flex;
            align-items: center;
            gap: 10px;
            white-space: nowrap;
        }

        .nav-section {
            margin-bottom: 24px;
        }

        .nav-section-title {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: #7c3aed;
            margin-bottom: 12px;
            font-weight: 700;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            border-radius: 10px;
            text-decoration: none;
            color: #a5b4fc;
            font-weight: 500;
            transition: all 0.3s ease;
            margin-bottom: 6px;
            border: 1.5px solid transparent;
            cursor: pointer;
            width: 100%;
            box-sizing: border-box;
            font-size: 0.95rem;
        }

        .nav-link:hover {
            background: rgba(139, 92, 246, 0.1);
            border-color: rgba(139, 92, 246, 0.4);
            color: #e0e7ff;
            transform: translateX(3px);
        }

        .nav-link.active {
            background: rgba(139, 92, 246, 0.2);
            border-color: #8b5cf6;
            color: #e0e7ff;
            box-shadow: 0 0 12px rgba(139, 92, 246, 0.3);
        }

        .nav-link.quiz {
            background: rgba(236, 72, 153, 0.1);
            border-color: rgba(236, 72, 153, 0.3);
        }

        .nav-link.quiz:hover {
            background: rgba(236, 72, 153, 0.2);
            border-color: rgba(236, 72, 153, 0.6);
            color: #fbcfe8;
        }

        .nav-icon {
            font-size: 1.3rem;
            width: 28px;
            text-align: center;
        }

        /* MAIN CONTENT */
        .main-wrapper {
            margin-left: 260px;
            overflow-y: auto;
            width: calc(100% - 260px);
            display: flex;
            flex-direction: column;
            height: 100vh;
        }

        /* BREADCRUMB */
        .breadcrumb-container {
            position: sticky;
            top: 0;
            z-index: 100;
            padding: 18px 40px;
            margin-bottom: 0;
            background: rgba(15, 23, 42, 0.95);
            border-bottom: 1px solid rgba(139, 92, 246, 0.15);
            border-radius: 0;
            backdrop-filter: blur(10px);
            flex-shrink: 0;
        }

        .content {
            padding: 32px 40px;
            flex: 1;
            width: 100%;
            box-sizing: border-box;
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            font-size: 0.95rem;
        }

        .breadcrumb-item {
            color: #a5b4fc;
            text-decoration: none;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 6px;
            transition: all 0.3s ease;
        }

        .breadcrumb-item:hover {
            background: rgba(139, 92, 246, 0.1);
            color: #c7d2fe;
        }

        .breadcrumb-item.active {
            color: #c7d2fe;
            font-weight: 600;
            cursor: default;
        }

        .breadcrumb-separator {
            color: #6366f1;
            font-weight: 300;
        }

        /* MAIN CONTENT */
        .content {
            background: transparent;
            border-radius: 16px;
        }

        /* RESPONSIVE */
        @@media (max-width: 1024px) {
            .app-container {
                grid-template-columns: 1fr;
            }

            .sidebar {
                position: fixed;
                left: -260px;
                transition: left 0.3s ease;
                z-index: 200;
                box-shadow: 2px 0 20px rgba(0, 0, 0, 0.5);
            }

            .sidebar.open {
                left: 0;
            }

            .main-wrapper {
                margin-left: 0;
            }
        }

        @@media (max-width: 640px) {
            .breadcrumb {
                font-size: 0.85rem;
                gap: 8px;
            }

            .main-wrapper {
                padding: 16px;
            }
        }

        /* Scrollbar styling */
        .sidebar::-webkit-scrollbar {
            width: 6px;
        }

        .sidebar::-webkit-scrollbar-track {
            background: rgba(139, 92, 246, 0.05);
            border-radius: 10px;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: rgba(139, 92, 246, 0.3);
            border-radius: 10px;
        }

        .sidebar::-webkit-scrollbar-thumb:hover {
            background: rgba(139, 92, 246, 0.5);
        }

        /* TABLE STYLING FOR INDEX PAGES */
        .index-container {
            background: rgba(139, 92, 246, 0.08);
            border-radius: 16px;
            padding: 28px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(139, 92, 246, 0.2);
        }

        .index-container h1 {
            color: #e0e7ff;
            margin-bottom: 24px;
            font-size: 2rem;
            font-weight: 700;
        }

        .index-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        .index-table thead {
            background-color: rgba(139, 92, 246, 0.15);
            border-bottom: 2px solid rgba(139, 92, 246, 0.3);
        }

        .index-table th {
            padding: 14px;
            text-align: left;
            color: #c7d2fe;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .index-table td {
            padding: 14px;
            border-bottom: 1px solid rgba(139, 92, 246, 0.1);
            color: #cbd5e1;
        }

        .index-table tbody tr:hover {
            background-color: rgba(139, 92, 246, 0.05);
        }

        .index-table strong {
            color: #e0e7ff;
        }

        .index-table a {
            color: #60a5fa;
            text-decoration: none;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .index-table a:hover {
            color: #c7d2fe;
            text-decoration: underline;
        }

        /* DETAILS PAGE STYLING */
        .details-container {
            background: transparent;
            border-radius: 16px;
            padding: 0;
            backdrop-filter: blur(10px);
            border: none;
        }

        .details-container h1 {
            color: #e0e7ff;
            margin-bottom: 32px;
            font-size: 2.5rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .details-header {
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(59, 130, 246, 0.15));
            border: 1px solid rgba(139, 92, 246, 0.3);
            border-radius: 16px;
            padding: 32px;
            margin-bottom: 32px;
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 32px rgba(139, 92, 246, 0.1);
        }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .detail-card {
            background: rgba(139, 92, 246, 0.08);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 12px;
            padding: 20px;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
            overflow: hidden;
            position: relative;
        }

        .detail-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, #8b5cf6, #3b82f6);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .detail-card:hover {
            border-color: rgba(139, 92, 246, 0.5);
            background: rgba(139, 92, 246, 0.12);
            box-shadow: 0 8px 24px rgba(139, 92, 246, 0.15);
            transform: translateY(-2px);
        }

        .detail-card:hover::before {
            opacity: 1;
        }

        .detail-card-label {
            color: #a5b4fc;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
            margin-bottom: 8px;
            display: block;
        }

        .detail-card-value {
            color: #e0e7ff;
            font-size: 1.1rem;
            font-weight: 600;
            word-break: break-word;
        }

        .detail-card-value.highlight {
            color: #60a5fa;
            font-size: 1.3rem;
        }

        .detail-card-value.success {
            color: #10b981;
        }

        .detail-card-value.danger {
            color: #ef4444;
        }

        .detail-card-value.warning {
            color: #f59e0b;
        }

        .detail-card a {
            color: #60a5fa;
            text-decoration: none;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .detail-card a:hover {
            color: #c7d2fe;
            text-decoration: underline;
        }

        .details-section {
            background: rgba(139, 92, 246, 0.08);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 12px;
            padding: 28px;
            margin-bottom: 28px;
            backdrop-filter: blur(10px);
        }

        .details-section-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #c7d2fe;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .stat-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 16px;
            margin-bottom: 16px;
        }

        .stat-item {
            background: rgba(15, 23, 42, 0.5);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 8px;
            padding: 16px;
            text-align: center;
        }

        .stat-item-label {
            color: #a5b4fc;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .stat-item-value {
            color: #e0e7ff;
            font-size: 1.5rem;
            font-weight: 800;
        }

        .badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .badge-success {
            background: rgba(16, 185, 129, 0.2);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .badge-danger {
            background: rgba(239, 68, 68, 0.2);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }

        .badge-warning {
            background: rgba(245, 158, 11, 0.2);
            color: #f59e0b;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        .badge-info {
            background: rgba(59, 130, 246, 0.2);
            color: #3b82f6;
            border: 1px solid rgba(59, 130, 246, 0.3);
        }

        .icon-label {
            font-size: 1.8rem;
            display: inline-block;
            margin-right: 8px;
        }

        @@keyframes pulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(236, 72, 153, 0.4); }
            50% { box-shadow: 0 0 0 10px rgba(236, 72, 153, 0); }
        }

        .nav-link.quiz {
            animation: pulse 2s ease-in-out infinite;
        }
    </style>
</head>
<body>
    <div class="app-container">
        <!-- SIDEBAR NAVIGATION -->
        <aside class="sidebar">
            <div class="sidebar-header">
                TT Tracker
            </div>

            <nav class="nav-section">
                <div class="nav-section-title">Core Navigation</div>
                <a href="/" class="nav-link home" data-breadcrumb="Home">
                    <span class="nav-icon">🏠</span>
                    <span>Home</span>
                </a>
            </nav>

            <nav class="nav-section">
                <div class="nav-section-title">Entities</div>
                <a href="/tournaments/list" class="nav-link tournaments" data-breadcrumb="Tournaments">
                    <span class="nav-icon">🏆</span>
                    <span>Tournaments</span>
                </a>
                <a href="/venues/overview" class="nav-link venues" data-breadcrumb="Venues">
                    <span class="nav-icon">🏢</span>
                    <span>Venues</span>
                </a>
                <a href="/players/list" class="nav-link players" data-breadcrumb="Players">
                    <span class="nav-icon">👥</span>
                    <span>Players</span>
                </a>
                <a href="/matches/all" class="nav-link matches" data-breadcrumb="Matches">
                    <span class="nav-icon">⚔️</span>
                    <span>Matches</span>
                </a>
                <a href="/registrations/current" class="nav-link registrations" data-breadcrumb="Registrations">
                    <span class="nav-icon">📋</span>
                    <span>Registrations</span>
                </a>
                <a href="/match-participants/list" class="nav-link matchparticipants" data-breadcrumb="Participants">
                    <span class="nav-icon">🎯</span>
                    <span>Participants</span>
                </a>
                <a href="/match-set-results/list" class="nav-link matchsetresults" data-breadcrumb="Set Results">
                    <span class="nav-icon">📊</span>
                    <span>Set Results</span>
                </a>
            </nav>

            <nav class="nav-section">
                <div class="nav-section-title">Special Features</div>
                <a href="/Quiz" class="nav-link quiz" data-breadcrumb="Quiz">
                    <span class="nav-icon">🧠</span>
                    <span>Quiz Master</span>
                </a>
            </nav>
        </aside>

        <!-- MAIN CONTENT -->
        <div class="main-wrapper">
            <!-- BREADCRUMB -->
            <div class="breadcrumb-container">
                <nav class="breadcrumb">
                    @{
                        var breadcrumbs = (List<(string Label, string Url)>)ViewData["Breadcrumbs"];
                        if (breadcrumbs == null || breadcrumbs.Count == 0)
                        {
                            breadcrumbs = new List<(string, string)> { ("Home", "/") };
                        }
                    }

                    @foreach (var (i, breadcrumb) in breadcrumbs.Select((x, i) => (i, x)))
                    {
                        @if (i < breadcrumbs.Count - 1)
                        {
                            <a href="@breadcrumb.Url" class="breadcrumb-item">@breadcrumb.Label</a>
                            <span class="breadcrumb-separator">→</span>
                        }
                        else
                        {
                            <span class="breadcrumb-item active">@breadcrumb.Label</span>
                        }
                    }
                </nav>
            </div>

            <!-- PAGE CONTENT -->
            <div class="content">
                @RenderBody()
            </div>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/autocomplete-dropdown.js"></script>
    <script src="~/js/form-validation.js"></script>
    <script src="~/js/animations.js"></script>

    <script>
        // Set active navigation state based on current page
        document.addEventListener("DOMContentLoaded", function() {
            const currentPath = window.location.pathname.toLowerCase();
            const navLinks = document.querySelectorAll(".nav-link");
            
            navLinks.forEach(link => {
                const href = link.getAttribute("href").toLowerCase();
                // Check if the current path matches the link (handle both exact and prefix matches)
                if (currentPath === href || currentPath.startsWith(href + "/") || 
                    (href === "/" && currentPath === "/")) {
                    link.classList.add("active");
                } else {
                    link.classList.remove("active");
                }
            });
        });
    </script>
</body>
</html>
