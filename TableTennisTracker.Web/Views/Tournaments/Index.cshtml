@model IEnumerable<TableTennisTracker.Domain.Models.Tournament>

@{
    ViewData["Title"] = "Tournaments";
    ViewData["Breadcrumbs"] = new List<(string, string)> { ("Home", "/"), ("Tournaments", "/Tournaments") };
}

<style>
    .tournaments-header {
        margin-bottom: 32px;
    }

    .tournaments-header h1 {
        font-size: 2.2rem;
        color: #e0e7ff;
        margin-bottom: 8px;
        font-weight: 700;
    }

    .tournaments-filter {
        display: flex;
        gap: 12px;
        margin-top: 16px;
        flex-wrap: wrap;
    }

    .filter-btn {
        padding: 8px 16px;
        border-radius: 8px;
        border: 1px solid rgba(139, 92, 246, 0.3);
        background: rgba(139, 92, 246, 0.1);
        color: #a5b4fc;
        cursor: pointer;
        font-weight: 500;
        transition: all 0.3s ease;
        font-size: 0.9rem;
    }

    .filter-btn:hover,
    .filter-btn.active {
        background: rgba(139, 92, 246, 0.2);
        border-color: rgba(139, 92, 246, 0.5);
        color: #e0e7ff;
    }

    .tournaments-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 24px;
        margin-bottom: 32px;
    }

    .tournament-card {
        background: rgba(139, 92, 246, 0.08);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 14px;
        overflow: hidden;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        cursor: pointer;
    }

    .tournament-card:hover {
        transform: translateY(-8px);
        border-color: rgba(139, 92, 246, 0.4);
        box-shadow: 0 16px 40px rgba(139, 92, 246, 0.15);
    }

    .tournament-card-header {
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(59, 130, 246, 0.15));
        padding: 20px;
        border-bottom: 1px solid rgba(139, 92, 246, 0.2);
    }

    .tournament-card-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #e0e7ff;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .tournament-season {
        display: inline-block;
        background: rgba(59, 130, 246, 0.2);
        color: #93c5fd;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .tournament-card-body {
        padding: 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .tournament-detail {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .tournament-detail-label {
        color: #8b5cf6;
        font-size: 0.85rem;
        text-transform: uppercase;
        font-weight: 600;
    }

    .tournament-detail-value {
        color: #cbd5e1;
        font-weight: 500;
    }

    .tournament-dates {
        background: rgba(139, 92, 246, 0.1);
        border-radius: 8px;
        padding: 12px;
        border-left: 3px solid rgba(139, 92, 246, 0.4);
    }

    .tournament-date-item {
        font-size: 0.9rem;
        color: #a5b4fc;
        margin-bottom: 4px;
    }

    .tournament-date-item:last-child {
        margin-bottom: 0;
    }

    .tournament-participants {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .participant-badge {
        background: rgba(245, 158, 11, 0.2);
        color: #fbbf24;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .tournament-ranking {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .ranking-badge {
        background: rgba(245, 158, 11, 0.2);
        color: #fbbf24;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.8rem;
    }

    .tournament-card-footer {
        padding: 16px 20px;
        border-top: 1px solid rgba(139, 92, 246, 0.2);
        display: flex;
        gap: 10px;
    }

    .btn-details {
        flex: 1;
        padding: 10px 16px;
        background: rgba(59, 130, 246, 0.2);
        border: 1px solid rgba(59, 130, 246, 0.3);
        color: #93c5fd;
        border-radius: 8px;
        text-decoration: none;
        text-align: center;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .btn-details:hover {
        background: rgba(59, 130, 246, 0.3);
        border-color: rgba(59, 130, 246, 0.5);
        color: #e0e7ff;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #8b5cf6;
    }

    .empty-state-icon {
        font-size: 3rem;
        margin-bottom: 16px;
    }

    .empty-state-text {
        font-size: 1.1rem;
        margin-bottom: 8px;
    }

    @@media (max-width: 768px) {
        .tournaments-grid {
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 16px;
        }

        .tournaments-header h1 {
            font-size: 1.8rem;
        }
    }

    @@media (max-width: 480px) {
        .tournaments-grid {
            grid-template-columns: 1fr;
        }

        .tournament-card-title {
            font-size: 1.1rem;
        }
    }
</style>

<div class="index-container">
    <div class="tournaments-header">
        <h1>🏆 Tournaments</h1>
        <p style="color: #a5b4fc; margin-top: 8px;">Browse and manage all tournaments</p>
    </div>

    @if (Model.Any())
    {
        <div class="tournaments-grid">
            @foreach (var tournament in Model)
            {
                <div class="tournament-card">
                    <div class="tournament-card-header">
                        <div class="tournament-card-title">
                            @tournament.Name
                        </div>
                        <span class="tournament-season">@tournament.SeasonLabel</span>
                    </div>
                    
                    <div class="tournament-card-body">
                        <div class="tournament-dates">
                            <div class="tournament-date-item">
                                <strong>📅 Start:</strong> @tournament.StartUtc.ToString("MMM dd, yyyy HH:mm")
                            </div>
                            <div class="tournament-date-item">
                                <strong>📅 End:</strong> @tournament.EndUtc.ToString("MMM dd, yyyy HH:mm")
                            </div>
                        </div>

                        <div class="tournament-detail">
                            <span class="tournament-detail-label">👥 Max Players</span>
                            <span class="participant-badge">@tournament.MaxPlayers players</span>
                        </div>

                        <div class="tournament-detail">
                            <span class="tournament-detail-label">🏢 Venue</span>
                            <span class="tournament-detail-value">@(tournament.Venue?.Name ?? "N/A")</span>
                        </div>

                        <div class="tournament-detail">
                            <span class="tournament-detail-label">👤 Organizer</span>
                            <span class="tournament-detail-value">@tournament.OrganizerName</span>
                        </div>

                        <div class="tournament-detail">
                            <span class="tournament-detail-label">🎯 Best of</span>
                            <span class="tournament-detail-value">@tournament.BestOfSets sets</span>
                        </div>

                        @if (tournament.IsRankingEvent)
                        {
                            <div class="tournament-detail">
                                <span class="tournament-detail-label">⭐ Ranking Event</span>
                                <div class="ranking-badge">★</div>
                            </div>
                        }
                    </div>

                    <div class="tournament-card-footer">
                        <a href="/Tournaments/Details/@tournament.Id" class="btn-details">View Details →</a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">🏆</div>
            <div class="empty-state-text">No tournaments yet</div>
            <p style="color: #6b7280; font-size: 0.95rem;">Create your first tournament to get started</p>
        </div>
    }
</div>
