@model IEnumerable<TableTennisTracker.Domain.Models.Tournament>

@{
    ViewData["Title"] = "Tournaments";
    ViewData["Breadcrumbs"] = new List<(string, string)> { ("Home", "/"), ("Tournaments", "/tournaments/list") };
}

<style>
    .tournaments-header {
        margin-bottom: 32px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }

    .header-controls {
        display: flex;
        gap: 12px;
        align-items: center;
        flex: 1;
        min-width: 0;
        width: 100%;
    }

    .tournaments-header h1 {
        font-size: 2.2rem;
        color: #e0e7ff;
        margin-bottom: 0;
        font-weight: 700;
    }

    .search-box {
        flex: 1;
        min-width: 0;
        width: 100%;
        padding: 10px 14px;
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 8px;
        color: #e0e7ff;
        font-size: 0.9rem;
    }

    .search-box::placeholder {
        color: #6b7280;
    }

    .btn-primary {
        background: rgba(139, 92, 246, 0.9);
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        font-size: 0.9rem;
        transition: background 0.3s;
    }

    .btn-primary:hover {
        background: rgba(139, 92, 246, 1);
    }

    .tournaments-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .tournament-row {
        background: rgba(139, 92, 246, 0.08);
        border: 1px solid rgba(139, 92, 246, 0.15);
        border-radius: 8px;
        padding: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.2s;
    }

    .tournament-row:hover {
        background: rgba(139, 92, 246, 0.12);
        border-color: rgba(139, 92, 246, 0.25);
    }

    .tournament-info {
        flex: 1;
    }

    .tournament-name {
        color: #e0e7ff;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .tournament-meta {
        color: #9ca3af;
        font-size: 0.85rem;
    }

    .tournament-actions {
        display: flex;
        gap: 8px;
        margin-left: 16px;
    }

    .btn-small {
        padding: 6px 12px;
        font-size: 0.8rem;
        text-decoration: none;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        display: inline-block;
    }

    .btn-view {
        background: rgba(34, 197, 94, 0.2);
        color: #86efac;
        border: 1px solid rgba(34, 197, 94, 0.3);
    }

    .btn-edit {
        background: rgba(59, 130, 246, 0.2);
        color: #93c5fd;
        border: 1px solid rgba(59, 130, 246, 0.3);
    }

    .btn-delete {
        background: rgba(239, 68, 68, 0.2);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .btn-small:hover {
        opacity: 0.8;
    }
</style>

<div class="tournaments-header">
    <h1>🏆 Tournaments</h1>
    <div class="header-controls">
        <input type="text" id="searchInput" class="search-box" placeholder="Search tournaments by name or season...">
        <a href="/tournaments/create" class="btn-primary">+ Add New Tournament</a>
    </div>
</div>

<div id="resultsList" class="tournaments-list">
    @await Html.PartialAsync("_TournamentsList", Model)
</div>

<script>
    $(document).ready(function() {
        $('#searchInput').on('keyup', function() {
            var query = $(this).val();
            $.get('/tournaments/search?query=' + encodeURIComponent(query), function(data) {
                $('#resultsList').html(data);
            });
        });
    });
</script>
