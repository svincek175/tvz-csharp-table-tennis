@model TableTennisTracker.Domain.Models.Venue

@{
    ViewData["Title"] = "Add New Venue";
    ViewData["Breadcrumbs"] = new List<(string, string)> { ("Home", "/"), ("Venues", "/venues/overview"), ("Create", "") };
}

<style>
    .form-container {
        max-width: 500px;
        margin: 0 auto;
    }

    .form-header {
        margin-bottom: 32px;
    }

    .form-header h1 {
        color: #e0e7ff;
        font-size: 1.8rem;
        margin-bottom: 8px;
    }

    .form-group {
        margin-bottom: 36px;
    }

    .form-label {
        display: block;
        color: #e0e7ff;
        margin-bottom: 10px;
        font-weight: 500;
        font-size: 0.9rem;
    }

    .form-control {
        width: 100%;
        padding: 13px 14px;
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 6px;
        color: #e0e7ff;
        font-size: 0.9rem;
        box-sizing: border-box;
    }

    .form-control:focus {
        outline: none;
        border-color: rgba(139, 92, 246, 0.5);
        background: rgba(139, 92, 246, 0.15);
    }

    .form-control::placeholder {
        color: #6b7280;
    }

    .validation-error {
        color: #fca5a5;
        font-size: 0.8rem;
        margin-top: 6px;
        margin-bottom: 16px;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 28px;
    }

    .btn-submit {
        background: rgba(139, 92, 246, 0.9);
        color: white;
        padding: 11px 24px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.95rem;
        font-weight: 500;
        transition: background 0.3s;
    }

    .btn-submit:hover {
        background: rgba(139, 92, 246, 1);
    }

    .btn-cancel {
        background: transparent;
        color: #9ca3af;
        padding: 11px 24px;
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        font-size: 0.95rem;
        transition: all 0.3s;
    }

    .btn-cancel:hover {
        color: #e0e7ff;
        border-color: rgba(139, 92, 246, 0.4);
    }
</style>

<div class="form-container">
    <div class="form-header">
        <h1>🏢 Add New Venue</h1>
    </div>

    <form method="post" action="/venues/create">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="form-label">Name *</label>
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", @placeholder = "Venue Name" })
            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "validation-error" })
        </div>

        <div class="form-group">
            <label class="form-label">City *</label>
            @Html.TextBoxFor(m => m.City, new { @class = "form-control", @placeholder = "New York" })
            @Html.ValidationMessageFor(m => m.City, "", new { @class = "validation-error" })
        </div>

        <div class="form-group">
            <label class="form-label">Country Code *</label>
            @Html.TextBoxFor(m => m.CountryCode, new { @class = "form-control", @placeholder = "US", maxlength = "2" })
            @Html.ValidationMessageFor(m => m.CountryCode, "", new { @class = "validation-error" })
        </div>

        <div class="form-group">
            <label class="form-label">Address Line</label>
            @Html.TextBoxFor(m => m.AddressLine, new { @class = "form-control", @placeholder = "123 Main St" })
            @Html.ValidationMessageFor(m => m.AddressLine, "", new { @class = "validation-error" })
        </div>

        <div class="form-group">
            <label class="form-label">Number of Tables</label>
            @Html.TextBoxFor(m => m.NumberOfTables, new { @class = "form-control", type = "number", @placeholder = "10" })
            @Html.ValidationMessageFor(m => m.NumberOfTables, "", new { @class = "validation-error" })
        </div>

        <div class="form-group">
            <label class="form-label">Capacity</label>
            @Html.TextBoxFor(m => m.Capacity, new { @class = "form-control", type = "number", @placeholder = "100" })
            @Html.ValidationMessageFor(m => m.Capacity, "", new { @class = "validation-error" })
        </div>

        <div class="form-group">
            <label class="form-label">Time Zone ID</label>
            @Html.TextBoxFor(m => m.TimeZoneId, new { @class = "form-control", @placeholder = "America/New_York" })
            @Html.ValidationMessageFor(m => m.TimeZoneId, "", new { @class = "validation-error" })
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">Create Venue</button>
            <a href="/venues/overview" class="btn-cancel">Cancel</a>
        </div>
    </form>
</div>
