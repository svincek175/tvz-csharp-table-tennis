@model IEnumerable<TableTennisTracker.Domain.Models.Venue>

@{
    ViewData["Title"] = "Venues";
    ViewData["Breadcrumbs"] = new List<(string, string)> { ("Home", "/"), ("Venues", "/Venues") };
}

<style>
    .venues-header {
        margin-bottom: 32px;
    }

    .venues-header h1 {
        font-size: 2.2rem;
        color: #e0e7ff;
        margin-bottom: 8px;
        font-weight: 700;
    }

    .venues-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 24px;
    }

    .venue-card {
        background: rgba(139, 92, 246, 0.08);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 14px;
        overflow: hidden;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
    }

    .venue-card:hover {
        transform: translateY(-8px);
        border-color: rgba(139, 92, 246, 0.4);
        box-shadow: 0 16px 40px rgba(139, 92, 246, 0.15);
    }

    .venue-card-header {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(139, 92, 246, 0.15));
        padding: 20px;
        border-bottom: 1px solid rgba(139, 92, 246, 0.2);
    }

    .venue-name {
        font-size: 1.3rem;
        font-weight: 700;
        color: #e0e7ff;
        margin-bottom: 8px;
    }

    .venue-location {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #a5b4fc;
        font-size: 0.9rem;
    }

    .venue-card-body {
        padding: 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .venue-detail {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(139, 92, 246, 0.1);
    }

    .venue-detail:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .venue-detail-label {
        color: #8b5cf6;
        font-size: 0.85rem;
        text-transform: uppercase;
        font-weight: 600;
    }

    .venue-detail-value {
        color: #cbd5e1;
        font-weight: 500;
        text-align: right;
    }

    .venue-stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        background: rgba(139, 92, 246, 0.1);
        border-radius: 10px;
        padding: 12px;
    }

    .stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .stat-value {
        font-size: 1.4rem;
        font-weight: 700;
        color: #60a5fa;
        margin-bottom: 4px;
    }

    .stat-label {
        font-size: 0.75rem;
        color: #8b5cf6;
        text-transform: uppercase;
        font-weight: 600;
    }

    .venue-card-footer {
        padding: 14px 20px;
        border-top: 1px solid rgba(139, 92, 246, 0.2);
    }

    .btn-details {
        width: 100%;
        padding: 10px 16px;
        background: rgba(59, 130, 246, 0.2);
        border: 1px solid rgba(59, 130, 246, 0.3);
        color: #93c5fd;
        border-radius: 8px;
        text-decoration: none;
        text-align: center;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .btn-details:hover {
        background: rgba(59, 130, 246, 0.3);
        border-color: rgba(59, 130, 246, 0.5);
        color: #e0e7ff;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #8b5cf6;
    }

    .empty-state-icon {
        font-size: 3rem;
        margin-bottom: 16px;
    }

    .empty-state-text {
        font-size: 1.1rem;
        margin-bottom: 8px;
    }

    @@media (max-width: 768px) {
        .venues-grid {
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 16px;
        }

        .venues-header h1 {
            font-size: 1.8rem;
        }
    }

    @@media (max-width: 480px) {
        .venues-grid {
            grid-template-columns: 1fr;
        }

        .venue-name {
            font-size: 1.1rem;
        }
    }
</style>

<div class="index-container">
    <div class="venues-header">
        <h1>🏢 Venues</h1>
        <p style="color: #a5b4fc; margin-top: 8px;">Manage tournament venues and facilities</p>
    </div>

    @if (Model.Any())
    {
        <div class="venues-grid">
            @foreach (var venue in Model)
            {
                <div class="venue-card">
                    <div class="venue-card-header">
                        <div class="venue-name">@venue.Name</div>
                        <div class="venue-location">
                            📍 @venue.City, @venue.CountryCode
                        </div>
                    </div>

                    <div class="venue-card-body">
                        <div class="venue-detail">
                            <span class="venue-detail-label">📍 Address</span>
                            <span class="venue-detail-value">@venue.AddressLine</span>
                        </div>

                        <div class="venue-stats">
                            <div class="stat">
                                <div class="stat-value">@venue.NumberOfTables</div>
                                <div class="stat-label">Tables</div>
                            </div>
                            <div class="stat">
                                <div class="stat-value">@venue.Capacity</div>
                                <div class="stat-label">Capacity</div>
                            </div>
                        </div>

                        <div class="venue-detail">
                            <span class="venue-detail-label">🕐 Time Zone</span>
                            <span class="venue-detail-value">@venue.TimeZoneId</span>
                        </div>
                    </div>

                    <div class="venue-card-footer">
                        <a href="/Venues/Details/@venue.Id" class="btn-details">View Details →</a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">🏢</div>
            <div class="empty-state-text">No venues yet</div>
            <p style="color: #6b7280; font-size: 0.95rem;">Add your first venue to get started</p>
        </div>
    }
</div>
